@echo off
REM Запуск скрипта main.py для чтения .docx файлов
REM Этот батник запускает Python скрипт двойным кликом

REM v2.5.3: фикс рабочей папки — при запуске от имени администратора cwd = system32,
REM и «python main.py» молча не находил файл; всегда переводим cwd в папку батника
cd /d "%~dp0"

python main.py

REM Команда pause не даёт окну закрыться сразу
REM Позволяет прочитать выведенный текст
pause
